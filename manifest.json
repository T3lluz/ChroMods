        "*://google.com.sg/*",
        "*://*.google.com.hk/*",
        "*://google.com.hk/*",
        "*://*.google.com.tw/*",
        "*://google.com.tw/*",
        "*://*.duckduckgo.com/*",
        "*://duckduckgo.com/*",

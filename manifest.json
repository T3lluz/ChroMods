        "*://*.google.fi/*",
        "*://google.fi/*",
        "*://*.google.ie/*",
        "*://google.ie/*",
        "*://*.google.pt/*",
        "*://google.pt/*",
        "*://*.google.ch/*",
        "*://google.ch/*",
        "*://*.google.at/*",
        "*://google.at/*",
        "*://*.google.be/*",
        "*://google.be/*",
        "*://*.google.com.tr/*",
        "*://google.com.tr/*",
        "*://*.google.co.nz/*",
        "*://google.co.nz/*",
        "*://*.google.co.za/*",
        "*://google.co.za/*",
        "*://*.google.com.ar/*",
        "*://google.com.ar/*",
        "*://*.google.com.sg/*",
        "*://google.com.sg/*",
        "*://*.google.com.hk/*",
        "*://google.com.hk/*",
        "*://*.google.com.tw/*",
        "*://google.com.tw/*",
        "*://*.duckduckgo.com/*",
        "*://duckduckgo.com/*",
        "*://*.x.com/*",
        "*://x.com/*",
        "*://*.twitter.com/*",
        "*://twitter.com/*"
      ],
      "js": ["scripts/sites.js", "scripts/content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/*/*.css"],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.github.com/*",

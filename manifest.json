{
  "manifest_version": 3,
  "name": "ChroMods",
  "short_name": "ChroMods",
  "version": "1.5.0",
  "description": "Chromium theming mods for websites — currently YouTube, GitHub, Google, DuckDuckGo, Gmail, Gemini, and X.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "host_permissions": [
    "<all_urls>",
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://*.github.com/*",
    "*://github.com/*",
    "*://*.google.com/*",
    "*://google.com/*",
    "*://*.google.co.uk/*",
    "*://google.co.uk/*",
    "*://*.google.de/*",
    "*://google.de/*",
    "*://*.google.fr/*",
    "*://google.fr/*",
    "*://*.google.ca/*",
    "*://google.ca/*",
    "*://*.google.com.au/*",
    "*://google.com.au/*",
    "*://*.google.co.jp/*",
    "*://google.co.jp/*",
    "*://*.google.co.in/*",
    "*://google.co.in/*",
    "*://*.google.com.br/*",
    "*://google.com.br/*",
    "*://*.google.es/*",
    "*://google.es/*",
    "*://*.google.it/*",
    "*://google.it/*",
    "*://*.google.nl/*",
    "*://google.nl/*",
    "*://*.google.pl/*",
    "*://google.pl/*",
    "*://*.google.com.mx/*",
    "*://google.com.mx/*",
    "*://*.google.co.kr/*",
    "*://google.co.kr/*",
    "*://*.google.se/*",
    "*://google.se/*",
    "*://*.google.no/*",
    "*://google.no/*",
    "*://*.google.dk/*",
    "*://google.dk/*",
    "*://*.google.fi/*",
    "*://google.fi/*",
    "*://*.google.ie/*",
    "*://google.ie/*",
    "*://*.google.pt/*",
    "*://google.pt/*",
    "*://*.google.ch/*",
    "*://google.ch/*",
    "*://*.google.at/*",
    "*://google.at/*",
    "*://*.google.be/*",
    "*://google.be/*",
    "*://*.google.com.tr/*",
    "*://google.com.tr/*",
    "*://*.google.co.nz/*",
    "*://google.co.nz/*",
    "*://*.google.co.za/*",
    "*://google.co.za/*",
    "*://*.google.com.ar/*",
    "*://google.com.ar/*",
    "*://*.google.com.sg/*",
    "*://google.com.sg/*",
    "*://*.google.com.hk/*",
    "*://google.com.hk/*",
    "*://*.google.com.tw/*",
    "*://google.com.tw/*",
    "*://*.duckduckgo.com/*",
    "*://duckduckgo.com/*",
    "*://*.x.com/*",
    "*://x.com/*",
    "*://*.twitter.com/*",
    "*://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChroMods",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scripts/dark-proxy.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "scripts/dark-chrome-guard.js",
        "scripts/vendor/darkreader.js",
        "scripts/dark-sites.js",
        "scripts/dark-mode.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.github.com/*",
        "*://github.com/*",
        "*://*.google.com/*",
        "*://google.com/*",
        "*://*.google.co.uk/*",
        "*://google.co.uk/*",
        "*://*.google.de/*",
        "*://google.de/*",
        "*://*.google.fr/*",
        "*://google.fr/*",
        "*://*.google.ca/*",
        "*://google.ca/*",
        "*://*.google.com.au/*",
        "*://google.com.au/*",
        "*://*.google.co.jp/*",
        "*://google.co.jp/*",
        "*://*.google.co.in/*",
        "*://google.co.in/*",
        "*://*.google.com.br/*",
